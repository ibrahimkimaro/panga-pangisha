# Copy to backend/.env (git-ignored) and fill in. docker compose reads it automatically.
# Gmail: turn on 2-step verification, create an "app password", and use it as MAIL_PASSWORD.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM_ADDRESS=you@gmail.com
MAIL_FROM_NAME="Panga na Kupangisha"

# Admin panel (http://localhost:8100/admin). The API creates or updates this account every time it starts.
ADMIN_EMAIL=admin@pangapangisha.co.tz
ADMIN_PASSWORD=choose-a-strong-password
